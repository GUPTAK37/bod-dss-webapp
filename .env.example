# --- Snowflake credentials (LOCAL DEV ONLY) ------------------------------------
# Inside Dataiku DSS these are read from project variables; you don't need
# any of the below when deployed to DSS.
#
# For local dev with SSO (browser popup):
SNOWFLAKE_USER=your.email@pfizer.com
SNOWFLAKE_ACCOUNT=pfizer.us-east-1
SNOWFLAKE_WAREHOUSE=VAW_AMER_COMMERCIAL_WH
SNOWFLAKE_DATABASE=VAW_AMER_PUB
SNOWFLAKE_SCHEMA=PUB_VAW_AMER_COVID_QCIT
SNOWFLAKE_ROLE=VAW_SF_COMMERCIAL_AMER_DESIGN_RW
SNOWFLAKE_AUTHENTICATOR=externalbrowser
# For key-pair (headless deploys):
# SNOWFLAKE_PRIVATE_KEY=

# If your ~/.snowflake/connections.toml holds an entry named other than
# AMERPROD01, override here:
# SNOWFLAKE_CONNECTION_NAME=AMERPROD01

# --- DSS (optional — only when you call DSSClient locally) --------------------
# DSS_HOST=https://dss-amer-design.pfizer.com
# DSS_API_KEY=
# DSS_PROJECT_KEY=COVID_QCIT
# DSS_NO_CERT_CHECK=false

# --- Dev-only synthetic identity (returned by /api/me when not in DSS) --------
# DEV_USER_LOGIN=local.dev@example.com
# DEV_USER_GROUPS=developers,analysts

# --- FastAPI dev server -------------------------------------------------------
FASTAPI_ENV=development
